<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="employee_supervised" model="hr.employee">
        <field name="name">Supervised</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="barcode">POSSUPERVISED</field>
    </record>

    <record id="employee_restrictive" model="hr.employee">
        <field name="name">Restrictive</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="barcode">POSRESTRICTIVE</field>
    </record>

    <record id="employee_cashier" model="hr.employee">
        <field name="name">Cashier</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="barcode">POSCASHIER</field>
    </record>

    <record id="employee_manager" model="hr.employee">
        <field name="name">Manager</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="barcode">POSMANAGER</field>
    </record>

    <function model="pos.config" name="_load_pos_hr_extra_demo_data"/>
</odoo>
