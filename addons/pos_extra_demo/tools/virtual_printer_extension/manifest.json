{
    "manifest_version": 3,
    "name": "Odoo POS Virtual Printer",
    "description": "Open the POS demo printer beside Odoo using Chrome's native split view.",
    "version": "1.1.0",
    "minimum_chrome_version": "155",
    "background": {
        "service_worker": "service_worker.js"
    },
    "host_permissions": ["https://pos.stva.ovh/*"],
    "content_scripts": [
        {
            "matches": [
                "*://localhost/pos/ui*",
                "*://localhost/pos/web*",
                "*://localhost/pos-self/*",
                "*://localhost/pos_preparation_display/web*",
                "*://127.0.0.1/pos/ui*",
                "*://127.0.0.1/pos/web*",
                "*://127.0.0.1/pos-self/*",
                "*://127.0.0.1/pos_preparation_display/web*"
            ],
            "js": ["content_script.js"]
        }
    ]
}
