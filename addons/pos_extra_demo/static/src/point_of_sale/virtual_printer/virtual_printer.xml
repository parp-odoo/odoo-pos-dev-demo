<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_extra_demo.DebugWidget" t-inherit="point_of_sale.DebugWidget" t-inherit-mode="extension">
        <xpath expr="//div[@data-tooltip='Print order receipt']" position="after">
            <div data-tooltip="Open virtual printer in browser split view" data-tooltip-delay="0">
                <a class="btn btn-secondary btn-sm text-nowrap"
                    data-pos-virtual-printer="true"
                    href="https://pos.stva.ovh/printer/test-p" target="_blank" rel="noopener noreferrer"
                    t-on-click="this.toggleWidget">
                    <i class="oi" data-icon="print" aria-hidden="true"/> Virtual Printer
                </a>
            </div>
        </xpath>
    </t>
</templates>
